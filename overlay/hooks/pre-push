#!/usr/bin/env bash
# SPDX-FileCopyrightText: 2026 Kartoza (Pty) Ltd <tim@kartoza.com>
# SPDX-License-Identifier: MIT
#
# Anti-leak guard (SRS FR-I5): refuses to push any commit that touches a
# qgis-dev-env overlay-owned path. The .git/info/exclude block prevents
# accidental staging; this catches `git add -f` muscle memory too.
set -euo pipefail

overlay_re='^(\.envrc|\.nvim\.lua|\.exrc|\.clangd|pyrightconfig\.json|PROMPT\.log|SRS-qgis-dev-env\.md|\.dev-env(/|$))'
fail=0

while read -r _local_ref local_sha _remote_ref remote_sha; do
  [[ "$local_sha" =~ ^0+$ ]] && continue # deleting a remote ref — nothing to scan
  if [[ "$remote_sha" =~ ^0+$ ]]; then
    # new remote branch: scan everything not already on some remote
    files="$(git log --format= --name-only "$local_sha" --not --remotes 2>/dev/null | sort -u)"
  else
    files="$(git diff --name-only "$remote_sha" "$local_sha" 2>/dev/null || true)"
  fi
  hits="$(printf '%s\n' "$files" | grep -E "$overlay_re" || true)"
  if [[ -n "$hits" ]]; then
    {
      echo "pre-push: BLOCKED — these commits touch qgis-dev-env overlay files:"
      printf '  %s\n' "$hits"
      echo "The developer-environment overlay must never reach upstream QGIS."
      echo "Remove the files from the commits (git rebase / git rm --cached) and retry."
    } >&2
    fail=1
  fi
done

exit "$fail"
